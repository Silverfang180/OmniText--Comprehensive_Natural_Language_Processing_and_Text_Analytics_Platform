# OmniText V2 Environment Configuration Template

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
API_DEBUG=true
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL + pgvector)
API_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/omnitext
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/omnitext

# Web / Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Worker Configuration
WORKER_POLL_INTERVAL_SECONDS=2
